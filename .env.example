DATABASE_URL=sqlite:///./devpilot.db
# Generate with cryptography.fernet.Fernet.generate_key(). No default exists.
ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
OLLAMA_URL=http://host.docker.internal:11434
OPENAI_URL=https://api.openai.com/v1
ANTHROPIC_URL=https://api.anthropic.com
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai
GROQ_URL=https://api.groq.com/openai/v1
DEEPSEEK_URL=https://api.deepseek.com
# Custom compatible endpoint: deployment administrator only, never user supplied.
COMPATIBLE_URL=
POSTGRES_PASSWORD=local-development-change-me
API_INTERNAL_URL=http://localhost:8000
# Requires Vercel Sandbox access; runtime OIDC is automatic when hosted on Vercel.
SANDBOX_ENABLED=false
